#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VERSION_TAG="${1:-$(git describe --tags --abbrev=0)}"

if [[ ! "$VERSION_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "error: expected a release tag in vX.Y.Z format, got '$VERSION_TAG'." >&2
    exit 1
fi

printf '%s\n' "$VERSION_TAG" > VERSION
echo "Application version synchronized to $VERSION_TAG."
