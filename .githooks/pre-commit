#!/usr/bin/env bash
set -euo pipefail

# Fast local guard only. Full static analysis, FilaCheck, Rector, and Pest
# belong in CI or explicit verification commands such as bin/agent-verify.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "Running fast pre-commit checks..."

# 1. PHP Lint
ERRORS=0
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        OUTPUT=$(php -l "$file" 2>&1)
        if [ $? -ne 0 ]; then
            echo "❌ Syntax error in $file:"
            echo "$OUTPUT"
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo ""
    echo "Commit blocked: $ERRORS PHP file(s) have syntax errors."
    exit 1
fi

echo "PHP lint passed"

# 2. Pint (code style)
if ! vendor/bin/pint --dirty --test --format=txt; then
    echo ""
    echo "Commit blocked: Pint found formatting issues."
    echo "Run 'vendor/bin/pint --dirty' to fix them."
    exit 1
fi

echo "Pint passed"


echo ""
echo "Fast pre-commit checks passed."
exit 0
