#!/bin/bash
# Pre-commit hook: lint, format, analyse, and test staged PHP files
# Prevents deploying syntax errors, style violations, static analysis issues, or failing tests

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "🔍 Running pre-commit checks..."

# 1. PHP Lint
ERRORS=0
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        OUTPUT=$(php -l "$file" 2>&1)
        if [ $? -ne 0 ]; then
            echo "❌ Syntax error in $file:"
            echo "$OUTPUT"
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo ""
    echo "⛔ Commit blocked: $ERRORS PHP file(s) have syntax errors."
    exit 1
fi

echo "✅ PHP lint passed"

# 2. Pint (code style)
vendor/bin/pint --dirty --format agent > /dev/null 2>&1
PINT_CHANGED=$(git diff --name-only | grep '\.php$')
if [ -n "$PINT_CHANGED" ]; then
    echo "⚠️  Pint fixed formatting issues. Staging the changes..."
    echo "$PINT_CHANGED" | xargs git add
fi

echo "✅ Pint passed"

# 3. TLint (Laravel/Blade idioms)
vendor/bin/tlint lint > /tmp/tlint-output 2>&1
if grep -q "^!" /tmp/tlint-output; then
    echo ""
    echo "⛔ Commit blocked: TLint found violations."
    echo "Run 'vendor/bin/tlint lint' to see details."
    exit 1
fi

echo "✅ TLint passed"

# 4. PHPStan (static analysis)
vendor/bin/phpstan analyse --no-progress --memory-limit=512M > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo ""
    echo "⛔ Commit blocked: PHPStan found errors."
    echo "Run 'vendor/bin/phpstan analyse' to see details."
    exit 1
fi

echo "✅ PHPStan passed"

# 5. Tests (only run if app/ or tests/ files are staged)
APP_OR_TEST_FILES=$(echo "$STAGED_FILES" | grep -E '^(app/|tests/)')
if [ -n "$APP_OR_TEST_FILES" ]; then
    php -d memory_limit=512M vendor/bin/pest --compact 2>&1 | tail -3
    if [ ${PIPESTATUS[0]} -ne 0 ]; then
        echo ""
        echo "⛔ Commit blocked: Tests failed."
        exit 1
    fi
    echo "✅ Tests passed"
else
    echo "⏭️  No app/test files staged, skipping tests"
fi

echo ""
echo "🎉 All checks passed!"
exit 0
