#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_PRE_PUSH_CHECKS:-0}" == "1" ]]; then
    echo "Skipping pre-push checks (SKIP_PRE_PUSH_CHECKS=1)."
    exit 0
fi

# Git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref. A delete has an all-zero local sha, so a push of only deletes sends no code.
has_updates=0

while read -r _ local_sha _ _ || [[ -n "$local_sha" ]]; do
    if [[ ! "$local_sha" =~ ^0+$ ]]; then
        has_updates=1
    fi
done

if [[ "$has_updates" == "0" ]]; then
    echo "Skipping pre-push checks (only deleting remote refs)."
    exit 0
fi

echo "Running KneadIt pre-push checks..."
composer check
