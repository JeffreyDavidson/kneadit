includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - app/
    level: 8
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanDirectories:
        - vendor/filament
    ignoreErrors:
        # Tenant domains relation from vendor trait (HasDomains)
        - identifier: larastan.relationExistence
        # Collection<Model> callback type — Larastan resolves to generic Model instead of concrete class
        -
            identifier: argument.type
            message: '#of method Illuminate\\(Database\\Eloquent\\|Support\\)Collection<[^>]+>::(map|mapWithKeys|sum|avg|filter|sortBy|each|groupBy)\(\) expects \(?callable\(Illuminate\\Database\\Eloquent\\Model#'
        # Builder::with() closure type — Larastan expects Relation<*,*,*> return but HasMany-typed closures are valid
        -
            identifier: argument.type
            message: '#of method Illuminate\\Database\\Eloquent\\Builder<[^>]+>::with\(\) expects#'
