includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
    level: 5
    scanDirectories:
        - vendor/filament
    ignoreErrors:
        # Trait uses dynamic property_exists check
        - identifier: staticProperty.notFound
          path: app/Traits/HasPlanGating.php
        # Grouped query requires get()->count()
        - identifier: larastan.noUnnecessaryCollectionCall
          path: app/Filament/Widgets/ReorderRemindersWidget.php
        # Tenant domains relation from vendor trait
        - identifier: larastan.relationExistence
          path: app/Http/Controllers/DirectoryController.php
        # Filament page properties provided by traits
        -
            message: '#Access to an undefined property .+::\$form#'
            paths:
                - app/Filament/Pages/
        -
            message: '#Access to an undefined property .+::\$(noteForm|survey)#'
            paths:
                - app/Filament/Pages/
        -
            message: '#Static method Filament\\Schemas\\Components\\Form::make\(\) invoked with 2 parameters#'
            paths:
                - app/Filament/Pages/
        -
            message: '#Call to an undefined method .+::(notify|sendSuccessNotification)\(\)#'
            paths:
                - app/Filament/
        # Filament $record typed as Model|int|string
        -
            message: '#on Illuminate\\Database\\Eloquent\\Model\|int\|string#'
            paths:
                - app/Filament/
        # Larastan can't resolve casts() method — dates/enums seen as string
        - identifier: method.nonObject
          message: '#Cannot call method .+ on string#'
        # Tenant model properties via tenant() helper return generic Model
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::#'
        # QrCode return type mismatch
        -
            message: '#SimpleSoftwareIO\\QrCode#'
        # Filament TextInput::uppercase() exists at runtime
        -
            message: '#Call to an undefined method Filament\\Forms\\Components\\TextInput::uppercase#'
        # Array|Model ambiguity in widgets
        - identifier: property.nonObject
          message: '#on array<string, mixed>\|Illuminate\\Database\\Eloquent\\Model#'
        # HasPlanGating method_exists check — needed for classes without RequiresRole trait
        - identifier: function.alreadyNarrowedType
          path: app/Traits/HasPlanGating.php
        # Collection<Model> callback type — Larastan resolves to generic Model instead of concrete class
        -
            identifier: argument.type
            message: '#callback of method Illuminate\\(Database\\Eloquent\\|Support\\)Collection.+::(map|mapWithKeys|sum|avg|filter|sortBy)\(\) expects callable\(Illuminate\\Database\\Eloquent\\Model#'
        # with() eager loading closure typed as Relation instead of Builder
        -
            identifier: argument.type
            message: '#of method Illuminate\\Database\\Eloquent\\Builder.+::with\(\) expects#'
        # Filament $record typed as Model|int|string|null in actions
        -
            identifier: argument.type
            message: '#Illuminate\\Database\\Eloquent\\Model\|int\|string(\|null)? given#'
            paths:
                - app/Filament/
        # Filament Form::make() parameter mismatch
        -
            identifier: argument.type
            message: '#static method Filament\\Schemas\\Components\\Form::make\(\) expects#'
        # Collection callback unresolvable types (complex closures)
        - identifier: argument.unresolvableType
        # Filament validate() string rules vs array rules
        -
            identifier: argument.type
            message: '#of method .*::validate\(\) expects array<string, array<mixed>>#'
        # Stripe Checkout session create parameter shape
        -
            identifier: argument.type
            path: app/Services/StripeCheckoutService.php
        # Collection<Model> sum/avg callback — Larastan generic issue
        -
            identifier: argument.type
            message: '#callback of method Illuminate\\Support\\Collection.+::(sum|avg)\(\) expects#'
        # TenantComparison expects Tenant, gets Model
        -
            identifier: argument.type
            message: '#expects App\\Models\\Tenant, Illuminate\\Database\\Eloquent\\Model given#'
